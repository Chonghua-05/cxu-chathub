    "skills": [
      {
        "name": "mc",
        "description": "MC 源码问答（先查 MinecraftDocs 机制文档定位，再翻 15 版源码）",
        "max_results": 6,
        "sources": [
          {
            "type": "repo",
            "repo": "AlexanderjFraser/MinecraftDocs",
            "branch": "main",
            "subdir": "src",
            "site_url": "https://minecraftdocs.dev",
            "extensions": [
              ".md"
            ],
            "exclude": [
              "summary.md",
              "reference/class-index",
              "generated/",
              "maps/",
              "figures/",
              "lectures.md"
            ],
            "name": "minecraftdocs",
            "stage": 1
          },
          {
            "type": "local",
            "root": "/data/docs/mc-source",
            "name": "mc-source",
            "extensions": [
              ".java"
            ],
            "stage": 2
          }
        ]
      },
      {
        "name": "tmc",
        "description": "GTMC 技术文章库（techmc.wiki，云端自动下载缓存）",
        "sources": [
          {
            "type": "repo",
            "repo": "techmc-wiki/articles",
            "branch": "main",
            "subdir": "",
            "site_url": "https://techmc.wiki",
            "name": "gtmc-articles"
          }
        ]
      },
      {
        "name": "docs",
        "description": "RMS 服务器文档（docs.cxu.org.cn，云端仓库自动下载缓存）",
        "sources": [
          {
            "type": "repo",
            "repo": "Conflux-Union/RMS-Docs",
            "branch": "master",
            "subdir": "",
            "site_url": "https://docs.cxu.org.cn",
            "name": "rms-docs"
          }
        ]
      },
      {
        "name": "wiki",
        "description": "中文 Minecraft Wiki（zh.minecraft.wiki）",
        "sources": [
          {
            "type": "mediawiki",
            "api_url": "https://zh.minecraft.wiki/api.php",
            "name": "minecraft-wiki"
          }
        ]
      }
    ]
  },
  "state_path": "/data/state.json",
  "log_level": "INFO",
  "patch_broadcast": {
    "enabled": false,
    "feed_url": "https://launchercontent.mojang.com/v2/javaPatchNotes.json",

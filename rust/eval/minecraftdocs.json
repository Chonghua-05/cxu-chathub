{
  "name": "minecraftdocs",
  "description": "Minecraft 系统机制文档（AlexanderjFraser/MinecraftDocs，!docs 语料；英文语料检索用英文关键词，nl-* 用例需 --llm 才激活）",
  "corpus": {
    "type": "repo",
    "repo": "AlexanderjFraser/MinecraftDocs",
    "branch": "main",
    "subdir": "src",
    "site_url": "https://minecraftdocs.dev",
    "extensions": [".md"],
    "exclude": ["summary.md", "reference/class-index"],
    "name": "minecraftdocs"
  },
  "top_k": 5,
  "cases": [
    { "id": "piston-events", "query": "piston block event", "expect": ["pistons-and-block-events"], "max_rank": 3,
      "note": "src/systems/blocks/pistons-and-block-events.md" },
    { "id": "enchanting", "query": "enchanting", "expect": ["items/enchanting"], "max_rank": 2,
      "note": "src/systems/items/enchanting.md；与 enchantments.md 相邻，允许其排前" },
    { "id": "pathfinding", "query": "pathfinding", "expect": ["entities/pathfinding"], "max_rank": 1,
      "note": "src/systems/entities/pathfinding.md，独特词" },
    { "id": "entity-collision", "query": "entity collision", "expect": ["movement-and-collision"], "max_rank": 3,
      "note": "src/systems/entities/movement-and-collision.md" },
    { "id": "chunk-tickets", "query": "chunk loading tickets", "expect": ["tickets-and-loading"], "max_rank": 3,
      "note": "src/systems/world/tickets-and-loading.md" },
    { "id": "world-lighting", "query": "lighting", "expect": ["world/lighting"], "max_rank": 3,
      "note": "src/systems/world/lighting.md；渲染侧 lightmap 页允许排前" },
    { "id": "scheduled-ticks", "query": "scheduled ticks", "expect": ["world/scheduled-ticks"], "max_rank": 2,
      "note": "src/systems/world/scheduled-ticks.md" },
    { "id": "game-events", "query": "game event vibration", "expect": ["game-events-and-vibrations"], "max_rank": 3,
      "note": "src/systems/world/game-events-and-vibrations.md" },
    { "id": "loot-tables", "query": "loot tables", "expect": ["items/loot-tables"], "max_rank": 2,
      "note": "src/systems/items/loot-tables.md" },
    { "id": "hunger", "query": "hunger", "expect": ["hunger-and-experience"], "max_rank": 2,
      "note": "src/systems/player/hunger-and-experience.md" },
    { "id": "block-entities", "query": "block entities", "expect": ["blocks/block-entities"], "max_rank": 1,
      "note": "实测：复数形态目标页排第一（语料惯用复数，分词无词干还原，单数「block entity」查不中）；渲染页 block-entity-rendering 允许排前" },
    { "id": "nl-pistons", "question": "活塞是怎么推动方块的", "expect": ["pistons-and-block-events"], "max_rank": 3,
      "note": "自然语言用例：需 --llm 翻译后激活，无 LLM 时跳过（不计数）" },
    { "id": "nl-chunk-load", "question": "区块什么时候会加载", "expect": ["tickets-and-loading"], "max_rank": 3,
      "note": "自然语言用例：需 --llm" },
    { "id": "nl-enchant", "question": "附魔是怎么工作的", "expect": ["items/enchanting"], "max_rank": 3,
      "note": "自然语言用例：需 --llm" }
  ]
}

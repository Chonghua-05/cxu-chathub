# ============================================================
# cxu-chathub Web 控制台 —— 环境变量样例
# 复制为 .env（docker compose 会自动读取）或 export 后 node server.js
# ============================================================

# ---- 控制台自身 ----
# 监听端口（建议只绑回环，对外用反代加 TLS）
PORT=9090
# 登录账号（生产环境务必改掉默认值！）
CXU_ADMIN_USER=admin
CXU_ADMIN_PASSWORD=change-me-please

# ---- cxu-chathub 服务 ----
# config.json 的绝对路径（写死在服务端，不接受前端传入）
# 注意：单文件 bind mount 部署时，控制台会自动检测挂载点并原地写入，
#       保证 docker restart 后容器能读到新配置。
CXU_CONFIG_PATH=/data/config.json
# cxu-chathub 的 HTTP API 地址（/api/status、/api/messages、/api/relay）
CXU_API_URL=http://127.0.0.1:8199
# 健康检查地址（重启后轮询它判断服务是否就绪；/healthz 在 6199 上常开）
CXU_HEALTH_URL=http://127.0.0.1:6199/healthz

# ---- 服务重启 ----
# 要 docker restart 的容器名
CXU_CONTAINER_NAME=chatroom-bridge-rust
# 是否允许控制台执行 docker restart（本机调试、无 docker.sock 时设 false）
CXU_DOCKER_ENABLED=true

# ---- 配置模板（可选）----
# 「恢复默认」用的模板文件；留空则使用内置默认模板
CXU_TEMPLATE_PATH=
